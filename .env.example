# ===== 生态Agent 环境变量示例 =====
# 复制为 .env 后按需修改（.env 已被 .gitignore 排除，不会进入版本库）
# 读取优先级：环境变量 > .env 文件 > 代码默认值

# ---- 服务 ----
# 0 = 自动挑选空闲端口（run.py 行为）；固定端口可写 5837
PORT=5837
# 覆盖数据库文件位置（默认 data/ecoagent.db）
# ECOAGENT_DB=

# ---- 模型接入（密钥只放这里，不要写进代码）----
# 方式一：应用启动时由环境变量写入 Provider 表并自动激活
# EA_LLM_API_KEY=sk-your-key-here
# EA_LLM_BASE_URL=https://api.deepseek.com
# EA_LLM_MODEL=deepseek-chat
# 指定目标 Provider 名称（默认：当前激活项，或首个非演示 Provider）
# EA_LLM_PROVIDER=DeepSeek

# 方式二（等价，v2.0 配置模型字段）：仅设置默认推理参数
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# ---- 联网搜索（SearXNG，可选）----
# 未配置时联网搜索自动降级，不影响本地知识库问答
# SEARXNG_ENABLED=true
# SEARXNG_URL=http://127.0.0.1:8888
# SEARXNG_TIMEOUT=30
# SEARXNG_MAX_RESULTS=10
# SEARXNG_LANGUAGE=zh-CN

# ---- 知识库/上下文预算（可选）----
# KB_TOP_K=5
# CONTEXT_SOFT_BUDGET=120000
# CONTEXT_HARD_BUDGET=200000
